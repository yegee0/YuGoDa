# ─── Google APIs ──────────────────────────────
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="YOUR_API_KEY"
VITE_GOOGLE_MAPS_MAP_ID="YOUR_MAP_ID"

# ─── iyzico Payment ──────────────────────────
IYZICO_API_KEY=dummy
IYZICO_SECRET_KEY=dummy
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ─── App URL (payment callbacks) ─────────────
APP_URL=http://localhost:4000

# ─── Firebase (optional, for server-side token verification) ───
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# FIREBASE_PROJECT_ID=yugoda-5b36a

# ─── Firebase customer project (yugoda-customer) ───────────────
# Uses Service Account Impersonation — no JSON key file needed.
# Cloud Run's default SA must have roles/iam.serviceAccountTokenCreator
# on the impersonated SA in the yugoda-customer GCP project.
FIREBASE_CUSTOMER_PROJECT_ID=
FIREBASE_CUSTOMER_IMPERSONATE_SA=
